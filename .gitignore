# Anchored to the repo root on purpose. Unanchored, `recordings/` also matched
# frontend/src/app/(dash)/recordings/ and silently kept the whole route out of
# git; these two are runtime directories at the top level, nothing else.
/data/
/recordings/
*.sock

# Incremental build state, rewritten on every `tsc` run and committed by
# accident every time someone stages the whole tree.
frontend/tsconfig.tsbuildinfo

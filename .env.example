# ---- app ----
APP_ENV=dev
APP_SECRET_KEY=change-me-32-bytes-minimum-secret
LOG_LEVEL=INFO

# ---- postgres ----
POSTGRES_USER=cam
POSTGRES_PASSWORD=cam
POSTGRES_DB=cam
DATABASE_URL=postgresql+asyncpg://cam:cam@postgres:5432/cam

# ---- redis ----
REDIS_URL=redis://redis:6379/0

# ---- secrets sealing key ----
# 32 bytes, base64. Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

# ---- minio / s3 ----
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cam-recordings
S3_ACCESS_KEY=cam-app
S3_SECRET_KEY=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# ---- storage policy (bytes) ----
STORAGE_WARN_BYTES=64424509440
STORAGE_GC_BYTES=96636764160
STORAGE_HARD_BYTES=105226698752

# ---- recording ----
RECORD_SEGMENT_SECONDS=10
RECORD_MAX_SECONDS=900
RECORD_DEFAULT_SECONDS=300
MAX_STREAMS_PER_USER=5
MAX_CONCURRENT_USERS=3

# ---- tunnels ----
TUNNEL_PORT_MIN=20000
TUNNEL_PORT_MAX=20099
SSH_CONTROL_DIR=/run/cam/ctl
NETNS_PREFIX=cam

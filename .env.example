# ---- app ----
APP_ENV=dev
APP_SECRET_KEY=change-me-32-bytes-minimum-secret
LOG_LEVEL=INFO

# ---- postgres ----
# One place for the password. The server is created with POSTGRES_PASSWORD and
# the app builds its connection string from these same four values, so they
# cannot drift apart -- which they did when the DSN was spelled out separately
# below: change one and the server rebuilds with the new password while every
# client still dials with the old, reported as "password authentication failed"
# for a password nobody is using any more.
#
# Note that POSTGRES_PASSWORD is read only when the data directory is created.
# Changing it later does nothing until the pgdata volume is removed, or until
# you run ALTER USER yourself.
POSTGRES_USER=cam
POSTGRES_PASSWORD=cam
POSTGRES_DB=cam
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Only for a database this compose file does not run -- a managed instance, or a
# host-run dev process. Set it and the four values above are ignored. Percent-
# encode anything reserved in the password: a DSN is a URL, and an "@" in it
# splits the string in the wrong place.
# DATABASE_URL=

# ---- redis ----
REDIS_URL=redis://redis:6379/0

# ---- secrets sealing key ----
# 32 bytes, base64. Generate: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

# ---- object storage: Versity Gateway ----
# Hosted on our own network. Swap in the internal address when it is available;
# nothing else changes. Path-style addressing either way -- Versity does not
# serve <bucket>.<host>.
S3_ENDPOINT_URL=https://s3.example.com
S3_ADDRESSING_STYLE=path
S3_BUCKET=cam-recordings
AWS_DEFAULT_REGION=us-east-1

# These are read under their AWS names so the same values work for the aws CLI.
# storage-root is a ROOT credential for an org-wide store -- see
# deploy/versity-setup.md for creating a scoped account for this app instead.
AWS_ACCESS_KEY_ID=storage-root
AWS_SECRET_ACCESS_KEY=

# ---- storage policy (bytes) ----
# Versity has no lifecycle rules and no bucket quota, so these are the only
# ceiling that exists. See app/storage/retention.py.
STORAGE_WARN_BYTES=64424509440
STORAGE_GC_BYTES=96636764160
STORAGE_HARD_BYTES=105226698752

# ---- recording ----
# Segment length is the blast radius of a dropped link: a recording loses at
# most the segment it was mid-way through, and TS segments play even then.
RECORD_SEGMENT_SECONDS=10
RECORD_MAX_SECONDS=900
RECORD_DEFAULT_SECONDS=300
MAX_STREAMS_PER_USER=5
MAX_CONCURRENT_USERS=3
# Where segments land before they are joined and uploaded. Must be a volume the
# agent can fill: a 5-minute 1080p session is roughly 150 MB per source.
WORK_DIR=/var/lib/cam/work

# ---- transcoding ----
# A preview of an H.265 camera has to be re-encoded -- no mainstream browser
# decodes H.265 over WebRTC -- and that is the only expensive thing here. An
# H.264 preview and every recording are stream copies.
#
# auto: use an NVIDIA card if one is visible inside the agent container, which
# needs `runtime: nvidia` in compose. Otherwise libx264.
TRANSCODE_ACCEL=auto
# The share of the machine this may spend. Streams past it are refused with a
# message naming the limit, which is the point: a machine admitted past its
# capacity does not fail, it judders across every stream at once and reads like
# a network problem.
GPU_BUDGET_PERCENT=80
CPU_BUDGET_PERCENT=80
# Concurrent NVENC sessions the card will take. Modern drivers lift the old
# three-session consumer cap; lower this if yours has not.
GPU_SESSIONS=16
# Cores one 1080p transcode costs. Measured at 0.55 on ultrafast; rounded up so
# a busy machine refuses before it starts stuttering.
CPU_COST_PER_STREAM=0.6

# ---- live preview ----
# Watching a camera without recording it: the agent copies the stream out of the
# namespace to MediaMTX, which serves it to the browser as WebRTC.
#
# Where the agent finds MediaMTX. The publish host is resolved to an address by
# the agent before ffmpeg is spawned, because the publisher runs inside a network
# namespace where Docker's resolver on 127.0.0.11 does not exist -- a name that
# reached ffmpeg would fail to resolve and read as though the camera were down.
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_PUBLISH_URL=rtsp://mediamtx:8554
# The address MediaMTX tells browsers to send WebRTC to; compose passes it as
# MTX_WEBRTCADDITIONALHOSTS. Left at the default, anyone watching from another
# machine negotiates a session and then waits forever for video being offered on
# a Docker-internal address. Set it to this host's LAN address.
# Accepts a comma-separated list, and usually needs one. The browser is offered
# every address here as a candidate and keeps whichever connects, so a
# deployment reached both from outside and from its own LAN should name both:
#
#   PREVIEW_HOST=cams.example.com,192.168.0.126
#
# Naming only the public host means a browser on the same network has to leave
# and come back through the router, which many of them will not do -- the page
# loads, the stream negotiates, and no video ever arrives.
PREVIEW_HOST=127.0.0.1
# What the browser dials to negotiate WebRTC. Empty keeps signalling on the
# dashboard's own origin, proxied to MediaMTX by the frontend -- the server
# cannot know what address the browser used to reach it, because every request
# arrives through that same proxy. Set this only when MediaMTX is exposed to
# browsers directly, port included. Either way the video itself flows straight
# from MediaMTX over UDP, which is what PREVIEW_HOST is for.
PREVIEW_PUBLIC_BASE=
# No viewers for this long and the stream is dropped. A preview holds a camera
# session open and cameras cap concurrent sessions hard, so a tab left open on a
# wall display is a session a recording cannot have. Too short and a page reload
# kills the stream out from under whoever reloaded.
PREVIEW_IDLE_SECONDS=45
# The ceiling on one preview, watched or not.
PREVIEW_MAX_SECONDS=3600
# How long to wait for frames to actually reach MediaMTX before giving up and
# saying what ffmpeg said. A publisher that connects and sends nothing is the
# common camera failure, and without this the browser gets a spinner with no
# explanation in it.
PREVIEW_READY_SECONDS=15
# How often the reaper sweeps. Nothing else ever ends a preview nobody closed.
PREVIEW_REAP_SECONDS=10

# ---- agent ----
# Where connecting happens. Compose sets CONNECT_MODE=agent on the api service
# because only the agent container has NET_ADMIN; a single-process dev run
# (make api) leaves it unset and connects in process.
# How long after pressing record the camera starts being dialled.
AGENT_POLL_SECONDS=2
# How often retention runs. Nothing on the gateway expires anything, so this
# sweep is the only thing that ever frees space.
RETENTION_SWEEP_SECONDS=300
HEARTBEAT_SECONDS=30

# ---- tunnels ----
TUNNEL_PORT_MIN=20000
TUNNEL_PORT_MAX=20099
SSH_CONTROL_DIR=/run/cam/ctl
NETNS_PREFIX=cam
# Networks reachable from inside a VPN namespace over the veth pair rather than
# the tunnel. Comma-separated, and never a default route. The Docker bridge is
# here by default; add the storage subnet only if something in a namespace
# genuinely needs it (uploads do not -- see app/net/netns.py).
CONTROL_CIDRS=172.16.0.0/12
# The compose bridge itself. Change it if this machine already has something on
# 172.28 -- `docker compose up` refuses to create an overlapping network -- and
# keep the replacement inside CONTROL_CIDRS above, or namespaces lose their
# route back to the control plane.
CONTROL_SUBNET=172.28.0.0/16
